function Show-Header {
    Clear-Host
    Write-Host "===============================================================================" -ForegroundColor Cyan
    Write-Host " Darkest Hour v1.05.2 (checksum TENE) - Unified Engine Patcher" -ForegroundColor Yellow
    Write-Host "===============================================================================" -ForegroundColor Cyan
    Write-Host " Included Fixes:" -ForegroundColor White
    Write-Host "   1. Configurable Expeditionary Forces to Players (AllowExpForcesToPlayers=0/1):"
    Write-Host "      Permits AI allies to send peacetime expeditionary forces to human players and"
    Write-Host "      grants operational control on human soil via mod_settings.ini (Default 0 = vanilla)."
    Write-Host "      (Front::GetLeadingCountry @ 0x004CCB2C & CGarrisonAI @ 0x00695520 / 0x007E2FB3)"
    Write-Host ""
    Write-Host "   2. Diplomatic 'dont_want_exp_forces' Respect:"
    Write-Host "      Prevents Garrison AI from sending overseas troops to allies who toggled"
    Write-Host "      'We do not want expeditionary forces' (eliminates infinite embark/recall loops)."
    Write-Host "      (CGarrisonAI::FindAlliedFrontNeedingTroops @ 0x00695593 / 0x007E2FCA)"
    Write-Host ""
    Write-Host "   3. Configurable Puppet Trade & Master Veto / Dual Embargo System:"
    Write-Host "      Permits puppet states to trade freely via 'db\mod_settings.ini' (AllowPuppetTrade=1/2)"
    Write-Host "      while enforcing Master Trade Embargoes, Tech Embargoes, and War checks (Mode 2)."
    Write-Host "      Eliminates hardcoded 0% puppet trade efficiency across all bilateral deals."
    Write-Host "      (CanPerformDiplomacyAction, Tooltips, AI Trade, CalculateTradeEfficiencies)"
    Write-Host ""
    Write-Host "   4. Checksum Synchronization for Engine Settings (db\mod_settings.ini):"
    Write-Host "      Natively incorporates 'db\mod_settings.ini' into the engine checksum routine"
    Write-Host "      (FUN_0042E3D0), preventing multiplayer desyncs across mismatched configurations."
    Write-Host "      (Inline Checksum Calculation @ 0x0042E710)"
    Write-Host ""
    Write-Host "   5. Fully Moddable & Configurable Straits System (EnableCustomStraits=0/1):"
    Write-Host "      Replaces vanilla hardcoded straits with CSV-driven data ('db\straits.csv' / 'map\straits.csv')."
    Write-Host "      Supports up to 4 controlling land provinces per strait, Normal vs Allied-only access rules,"
    Write-Host "      UI widgets/tooltips, global flag runtime override ('strait_<SeaProv>' = 1/2/3/4), and 'type = strait'."
    Write-Host "      (Core Transit @ 0x004ED1C0, UI Widgets @ 0x005F1337/171C/19C6, Command @ 0x00713861)"
    Write-Host ""
    Write-Host "   6. Large Address Aware (LAA) 4 GB Virtual Address Space Support:"
    Write-Host "      Enables IMAGE_FILE_LARGE_ADDRESS_AWARE (0x012F in PE Characteristics @ 0x00000116),"
    Write-Host "      doubling user virtual address space from 2,048 MB to 4,096 MB on 64-bit Windows."
    Write-Host ""
    Write-Host "   7. Scenario Unload Event Deallocation Cave (Engine Memory Leak Fix):"
    Write-Host "      Directly destructs and frees ~185,000 command objects upon scenario exit,"
    Write-Host "      eliminating the 137 MB per-reload engine memory leak natively in machine code."
    Write-Host "      (CEventAction::~CEventAction @ 0x0070287B / .mod Cave @ 0x00DCA000)"
    Write-Host ""
    Write-Host "   8. Map Tile High-Memory Signed Comparison Fix (LAA Crash Prevention):"
    Write-Host "      Substitutes signed JLE (0x7E) with unsigned JBE (0x76) at 0x004DB0C5 (FUN_004dafb0),"
    Write-Host "      preventing out-of-bounds pointer underruns in high address space (>= 0x80000000)"
    Write-Host "      from bypassing validation and dereferencing invalid province structures." 
    Write-Host ""
    Write-Host "   9. Silent Events for Player-Controlled Countries (Zero Popup Execution):"
    Write-Host "      Executes background maintenance events silently without spawning dialog windows,"
    Write-Host "      pausing the game, or requiring button clicks via 'ENGINE:SILENT_EVENT'."
    Write-Host "      (Event Dispatcher @ 0x007123CB / 0x00DCA200, Flags @ 0x007333B0, Loader @ 0x0070F380)"
    Write-Host ""
    Write-Host "   10. Allied & Military Access Territory Garrison AI:"
    Write-Host "      Configurable via 'db\mod_settings.ini' (EnableAlliedGarrison = 0/1/2):"
    Write-Host "        0 = Vanilla DH behavior (no foreign garrisons)"
    Write-Host "        1 = Allow garrisons in ally territory only"
    Write-Host "        2 = Allow garrisons in ally and military access territory (default)"
    Write-Host "      Per-country override via country local_flags (no_foreign_garrison = 0/1/2):"
    Write-Host "        0 = Allow ally and military access garrisons (default)"
    Write-Host "        1 = Allow only ally garrisons"
    Write-Host "        2 = Allow no foreign garrisons, ally or military access (vanilla DH behavior)"
    Write-Host ""
    Write-Host "   11. Engine Runtime Version Identifier (Global Flag GAME_VERSION):"
    Write-Host "      Automatically initializes global flag 'GAME_VERSION = 1' on every scenario"
    Write-Host "      and savegame load (FUN_0042E9B0 exit @ 0x0042EBF9 / .mod @ 0x00DCAE20)."
    Write-Host "      Enables dual-binary scripting (flag = 'GAME_VERSION' vs NOT = { flag = 'GAME_VERSION' })."
    Write-Host "      Configurable via 'db\mod_settings.ini' ([Engine] GameVersion = 1, Default 1)."
    Write-Host "-------------------------------------------------------------------------------" -ForegroundColor Gray
}

function Find-GameDirectory {
    $candidates = @()
    if ($ScriptDir) {
        $candidates += $ScriptDir
        $candidates += (Join-Path $ScriptDir "..\..")
        $candidates += (Join-Path $ScriptDir "..\..\..")
    }
    $candidates += (Get-Location).Path

    foreach ($cand in $candidates) {
        try {
            $resolved = [System.IO.Path]::GetFullPath($cand)
            $testExe = Join-Path $resolved "Darkest Hour.exe"
            $testOrig = Join-Path $resolved "Darkest Hour_original.exe"
            if ((Test-Path $testExe) -or (Test-Path $testOrig)) {
                return $resolved
            }
        } catch {}
    }
    return $null
}

function Check-FileState([string]$path) {
    if (-not (Test-Path $path)) {
        return @{ Exists = $false; State = "Missing"; Size = 0; Hash = ""; P1 = "Missing"; P2 = "Missing"; P3 = "Missing"; P4 = "Missing" }
    }
    $fi = New-Object System.IO.FileInfo($path)
    $size = $fi.Length
    $hash = (Get-FileHash -Path $path -Algorithm SHA256).Hash.ToUpper()

    $sig1Orig = $false; $sig1Patch = $false
    $sig2Orig = $false; $sig2Prev = $false; $sig2Patch = $false
    $sig3Orig = $false; $sig3Patch = $false
    $sig4Orig = $false; $sig4Patch = $false
    $sig5Orig = $false; $sig5Patch = $false

    try {
        $fs = [System.IO.File]::OpenRead($path)
        if ($fs.Length -ge ($SIG1_OFFSET + $PATCH1_SIG.Length)) {
            $null = $fs.Seek($SIG1_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf1 = New-Object byte[] $PATCH1_SIG.Length
            $null = $fs.Read($buf1, 0, $PATCH1_SIG.Length)
            $sig1Orig = ((Compare-Object $buf1[0..15] $ORIG1_SIG) -eq $null)
            $sig1Prev = ((Compare-Object $buf1[0..15] $PREV1_SIG) -eq $null)
            $sig1Patch = ((Compare-Object $buf1 $PATCH1_SIG) -eq $null)
        }
        if ($fs.Length -ge ($SIG2_OFFSET + 14)) {
            $null = $fs.Seek($SIG2_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf2 = New-Object byte[] 14
            $null = $fs.Read($buf2, 0, 14)
            $sig2Orig = ((Compare-Object $buf2 $ORIG2_SIG) -eq $null)
            $sig2Prev = ((Compare-Object $buf2 $PREV2_SIG) -eq $null)
            $sig2Patch = ((Compare-Object $buf2 $PATCH2_SIG) -eq $null)
        }
        if ($fs.Length -ge ($SIG3_OFFSET + 11)) {
            $null = $fs.Seek($SIG3_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf3 = New-Object byte[] 11
            $null = $fs.Read($buf3, 0, 11)
            $sig3Orig = ((Compare-Object $buf3 $ORIG3_SIG) -eq $null)
            $sig3Prev = ((Compare-Object $buf3 $PREV3_SIG) -eq $null)
            $sig3Patch = $sig3Orig
        }
        if ($fs.Length -ge ($SIG4_OFFSET + 16)) {
            $null = $fs.Seek($SIG4_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf4 = New-Object byte[] 16
            $null = $fs.Read($buf4, 0, 16)
            $sig4Orig = ((Compare-Object $buf4 $ORIG4_SIG) -eq $null)
            $sig4Patch = ((Compare-Object $buf4 $PATCH4_SIG) -eq $null)
        }
        if ($fs.Length -ge ($SIG5_OFFSET + 16)) {
            $null = $fs.Seek($SIG5_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf5 = New-Object byte[] 16
            $null = $fs.Read($buf5, 0, 16)
            $sig5Orig = ((Compare-Object $buf5 $ORIG5_SIG) -eq $null)
            $sig5Patch = ((Compare-Object $buf5 $PATCH5_SIG) -eq $null)
        }
        if ($fs.Length -ge ($SIG6_OFFSET + 5)) {
            $null = $fs.Seek($SIG6_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf6 = New-Object byte[] 5
            $null = $fs.Read($buf6, 0, 5)
            $sig6Orig = ((Compare-Object $buf6 $ORIG6_SIG) -eq $null)
            $sig6Patch = ((Compare-Object $buf6 $PATCH6_SIG) -eq $null)
        }
        $sigLaaPatch = $false
        if ($fs.Length -ge 0x00000118) {
            $null = $fs.Seek(0x00000116, [System.IO.SeekOrigin]::Begin)
            $charByte = $fs.ReadByte()
            $sigLaaPatch = (($charByte -band 0x20) -ne 0)
        }
        $sig8Orig = $false; $sig8Patch = $false
        if ($fs.Length -ge ($SIG8_OFFSET + 10)) {
            $null = $fs.Seek($SIG8_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf8 = New-Object byte[] 10
            $null = $fs.Read($buf8, 0, 10)
            $sig8Orig = ((Compare-Object $buf8 $ORIG8_SIG) -eq $null)
            $sig8Patch = ((Compare-Object $buf8 $PATCH8_SIG) -eq $null)
        }
        $sig9Orig = $false; $sig9Patch = $false
        if ($fs.Length -ge ($SIG9_OFFSET + 6)) {
            $null = $fs.Seek($SIG9_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf9 = New-Object byte[] 6
            $null = $fs.Read($buf9, 0, 6)
            $sig9Orig = ((Compare-Object $buf9 $ORIG9_SIG) -eq $null)
            $sig9Patch = ((Compare-Object $buf9 $PATCH9_SIG) -eq $null)
        }
        $sig10Orig = $false; $sig10Patch = $false
        if ($fs.Length -ge ($SIG10_OFFSET + 6)) {
            $null = $fs.Seek($SIG10_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf10 = New-Object byte[] 6
            $null = $fs.Read($buf10, 0, 6)
            $sig10Orig = ((Compare-Object $buf10 $ORIG10_SIG) -eq $null)
            $sig10Patch = ((Compare-Object $buf10 $PATCH10_SIG) -eq $null)
        }
        $sig11Orig = $false; $sig11Patch = $false
        if ($fs.Length -ge ($SIG11_OFFSET + 8)) {
            $null = $fs.Seek($SIG11_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf11 = New-Object byte[] 8
            $null = $fs.Read($buf11, 0, 8)
            $sig11Orig = ((Compare-Object $buf11 $ORIG11_SIG) -eq $null)
            $sig11Patch = ((Compare-Object $buf11 $PATCH11_SIG) -eq $null)
        }
        $sig12Orig = $false; $sig12Patch = $false
        if ($fs.Length -ge ($SIG12_OFFSET + 5)) {
            $null = $fs.Seek($SIG12_OFFSET, [System.IO.SeekOrigin]::Begin)
            $buf12 = New-Object byte[] 5
            $null = $fs.Read($buf12, 0, 5)
            $sig12Orig = ((Compare-Object $buf12 $ORIG12_SIG) -eq $null)
            $sig12Patch = ((Compare-Object $buf12 $PATCH12_SIG) -eq $null)
        }
        $fs.Close()
    } catch {
        return @{ Exists = $true; State = "Locked/Unreadable"; Size = $size; Hash = $hash }
    }

    $state = "Unknown"
    if ($sig1Orig -and $sig2Orig -and $sig4Orig -and $sig5Orig -and $sig6Orig -and -not $sigLaaPatch -and -not $sig8Patch -and $sig9Orig -and $sig10Orig -and $sig11Orig -and $sig12Orig) {
        $state = "Original"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and $sig5Patch -and $sig6Patch -and $sigLaaPatch -and $sig8Patch -and $sig9Patch -and $sig10Patch -and $sig11Patch -and $sig12Patch) {
        $state = "Patched (All Fixes + GAME_VERSION Flag)"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and $sig5Patch -and $sig6Patch -and $sigLaaPatch -and $sig8Patch -and $sig9Patch -and $sig10Patch -and $sig11Patch -and -not $sig12Patch) {
        $state = "Patched (v1.10 - All Fixes, No GAME_VERSION Flag)"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and $sig5Patch -and $sig6Patch -and $sigLaaPatch -and $sig8Patch -and $sig9Patch -and $sig10Patch -and -not $sig11Patch) {
        $state = "Patched (v1.9 - All Fixes, No Allied Garrison AI)"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and $sig5Patch -and $sig6Patch -and $sigLaaPatch -and $sig8Patch -and $sig9Patch -and -not $sig10Patch) {
        $state = "Patched (v1.8 - All Fixes, No Silent Events)"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and $sig5Patch -and $sig6Patch -and $sigLaaPatch -and $sig8Patch -and -not $sig9Patch) {
        $state = "Patched (v1.7 - All Fixes, No Map Guard)"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and $sig5Patch -and $sig6Patch -and $sigLaaPatch -and -not $sig8Patch) {
        $state = "Patched (v1.6 - All Fixes + Straits + LAA, No Event Cave)"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and $sig5Patch -and $sig6Patch -and -not $sigLaaPatch) {
        $state = "Patched (v1.5 - All Fixes + Straits, No LAA)"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and $sig5Patch -and -not $sig6Patch) {
        $state = "Patched (v1.4 - All Fixes, No Straits)"
    } elseif ($sig1Patch -and $sig2Patch -and $sig4Patch -and -not $sig5Patch) {
        $state = "Patched (v1.3 - All Fixes, No Checksum Sync)"
    } elseif ($sig1Prev -and $sig2Prev -and $sig3Prev -and $sig4Patch) {
        $state = "Patched (v1.2 - Hardcoded EXP + Puppet Trade)"
    } elseif ($sig1Prev -and $sig2Prev -and $sig3Prev -and -not $sig4Patch) {
        $state = "Patched (v1.1 - Hardcoded EXP only)"
    } elseif ($sig1Prev -and -not $sig4Patch) {
        $state = "Partially Patched (v1.0)"
    }

    return @{
        Exists      = $true
        State       = $state
        Size        = $size
        Hash        = $hash
        Sig1Orig    = $sig1Orig
        Sig1Patch   = $sig1Patch
        Sig2Orig    = $sig2Orig
        Sig2Prev    = $sig2Prev
        Sig2Patch   = $sig2Patch
        Sig3Orig    = $sig3Orig
        Sig3Patch   = $sig3Patch
        Sig4Orig    = $sig4Orig
        Sig4Patch   = $sig4Patch
        Sig5Orig    = $sig5Orig
        Sig5Patch   = $sig5Patch
        Sig6Orig    = $sig6Orig
        Sig6Patch   = $sig6Patch
        SigLaaPatch = $sigLaaPatch
        Sig8Orig    = $sig8Orig
        Sig8Patch   = $sig8Patch
        Sig9Orig    = $sig9Orig
        Sig9Patch   = $sig9Patch
        Sig10Orig   = $sig10Orig
        Sig10Patch  = $sig10Patch
        Sig11Orig   = $sig11Orig
        Sig11Patch  = $sig11Patch
        Sig12Orig   = $sig12Orig
        Sig12Patch  = $sig12Patch
    }
}

function Apply-PatchToFile([string]$srcPath, [string]$dstPath) {
    if (-not (Test-Path $srcPath)) {
        throw "Source file not found: $srcPath"
    }

    $srcState = Check-FileState $srcPath
    $validSizes = @($EXPECTED_SIZE, 4739072, 4743168)
    if ($srcState.Size -notin $validSizes) {
        throw "Source file size ($($srcState.Size) bytes) does not match expected Darkest Hour v1.05.2 ($EXPECTED_SIZE bytes)."
    }
    if (-not $srcState.Sig1Orig -and -not $srcState.Sig1Patch) {
        throw "Signature 1 at 0x{0:X8} did not match expected bytes." -f $SIG1_OFFSET
    }
    if (-not $srcState.Sig2Orig -and -not $srcState.Sig2Prev -and -not $srcState.Sig2Patch) {
        throw "Signature 2 at 0x{0:X8} did not match expected bytes." -f $SIG2_OFFSET
    }
    if (-not $srcState.Sig3Orig -and -not $srcState.Sig3Patch) {
        throw "Signature 3 at 0x{0:X8} did not match expected bytes." -f $SIG3_OFFSET
    }

    # If src and dst are different, copy first
    if ([System.IO.Path]::GetFullPath($srcPath) -ne [System.IO.Path]::GetFullPath($dstPath)) {
        Copy-Item -Path $srcPath -Destination $dstPath -Force
    }

    # Apply all four patches in dstPath
    try {
        $fs = [System.IO.File]::Open($dstPath, [System.IO.FileMode]::Open, [System.IO.FileAccess]::ReadWrite)
        
        # Patch 1: 17 bytes hook at 0x000CCCB6
        $null = $fs.Seek($PATCH1_OFFSET, [System.IO.SeekOrigin]::Begin)
        $fs.Write($PATCH1_SIG, 0, $PATCH1_SIG.Length)
        
        # Patch 2: 14 bytes hook at 0x00295593
        $null = $fs.Seek($PATCH2_OFFSET, [System.IO.SeekOrigin]::Begin)
        $fs.Write($PATCH2_SIG, 0, $PATCH2_SIG.Length)

        # Patch 3: 11 bytes code cave restore at 0x002955E5
        $null = $fs.Seek($PATCH3_OFFSET, [System.IO.SeekOrigin]::Begin)
        $fs.Write($PATCH3_SIG, 0, $PATCH3_SIG.Length)

        # Patch 4: Unified INI loader, Puppet Trade, and Cave 2 Hooks
        foreach ($chunk in $PATCH4_CHUNKS) {
            $chunkBytes = [System.Convert]::FromBase64String($chunk.Data)
            $null = $fs.Seek($chunk.Offset, [System.IO.SeekOrigin]::Begin)
            $fs.Write($chunkBytes, 0, $chunkBytes.Length)
        }

        # Patch 6: Configurable Straits System
        foreach ($chunk in $PATCH6_CHUNKS) {
            $chunkBytes = [System.Convert]::FromBase64String($chunk.Data)
            $null = $fs.Seek($chunk.Offset, [System.IO.SeekOrigin]::Begin)
            $fs.Write($chunkBytes, 0, $chunkBytes.Length)
        }

        # Patch 7: Large Address Aware (LAA) Flag (PE Characteristics @ 0x00000116)
        # Enables IMAGE_FILE_LARGE_ADDRESS_AWARE (0x012F), expanding address space to 4,096 MB.
        $null = $fs.Seek(0x00000116, [System.IO.SeekOrigin]::Begin)
        $fs.WriteByte(0x2F)

        # Patch 8: Scenario Unload Event Deallocation Cave (@ 0x0070287B / 0x00DCA000)
        foreach ($chunk in $PATCH8_CHUNKS) {
            $chunkBytes = [System.Convert]::FromBase64String($chunk.Data)
            $null = $fs.Seek($chunk.Offset, [System.IO.SeekOrigin]::Begin)
            $fs.Write($chunkBytes, 0, $chunkBytes.Length)
        }

        # Patch 9: Map Tile High-Memory Signed Comparison Fix (@ 0x004DB0C5)
        # Changes signed JLE (0x7E) to unsigned JBE (0x76), preventing LAA crashes
        $null = $fs.Seek($PATCH9_OFFSET, [System.IO.SeekOrigin]::Begin)
        $fs.WriteByte(0x76)

        # Patch 10: Silent Events for Player-Controlled Countries (@ 0x007123CB / 0x00DCA200)
        foreach ($chunk in $PATCH10_CHUNKS) {
            $chunkBytes = [System.Convert]::FromBase64String($chunk.Data)
            $null = $fs.Seek($chunk.Offset, [System.IO.SeekOrigin]::Begin)
            $fs.Write($chunkBytes, 0, $chunkBytes.Length)
        }

        # Patch 11: Allied Territory Garrison AI (@ 0x0068D8B9, 0x0068C18E, 0x0068C55A, 0x00DCA300)
        foreach ($chunk in $PATCH11_CHUNKS) {
            $chunkBytes = [System.Convert]::FromBase64String($chunk.Data)
            $null = $fs.Seek($chunk.Offset, [System.IO.SeekOrigin]::Begin)
            $fs.Write($chunkBytes, 0, $chunkBytes.Length)
        }

        # Patch 12: Engine Runtime Version Identifier (Global Flag GAME_VERSION @ 0x0042EBF9 / 0x00DCAE20)
        foreach ($chunk in $PATCH12_CHUNKS) {
            $chunkBytes = [System.Convert]::FromBase64String($chunk.Data)
            $null = $fs.Seek($chunk.Offset, [System.IO.SeekOrigin]::Begin)
            $fs.Write($chunkBytes, 0, $chunkBytes.Length)
        }

        # Ensure file length is padded to match expanded .mod section raw size (0x00484000 + 0x2000 = 0x00486000)
        if ($fs.Length -lt 0x00486000) {
            $fs.SetLength(0x00486000)
        }

        $fs.Flush()
        $fs.Close()
    } catch [System.IO.IOException] {
        throw "Target file '$dstPath' is locked or currently in use by Darkest Hour. Please close the game and try again."
    } catch {
        throw "Failed to write patch to '$dstPath': $($_.Exception.Message)"
    }

    # Ensure db\mod_settings.ini exists in destination directory
    $dstDir = [System.IO.Path]::GetDirectoryName([System.IO.Path]::GetFullPath($dstPath))
    $dstDb = Join-Path $dstDir "db"
    if (-not (Test-Path $dstDb)) {
        New-Item -ItemType Directory -Path $dstDb -Force | Out-Null
    }
    $dstIni = Join-Path $dstDb "mod_settings.ini"
    $legacyIni = Join-Path $dstDir "mod_settings.ini"
    if ((Test-Path $legacyIni) -and (-not (Test-Path $dstIni))) {
        Move-Item -Path $legacyIni -Destination $dstIni -Force
    }
    if (-not (Test-Path $dstIni)) {
        $iniDefault = @"
[Diplomacy]
; Allow Puppet Trade:
; 0 = Vanilla behavior (puppets can only trade with their master)
; 1 = Free trade (puppets can trade with any nation not at war)
; 2 = Free trade with Master Veto (puppets trade freely, but automatically respect master trade embargoes and master war enemies)
AllowPuppetTrade = 2

; Allow Expeditionary Forces to Players:
; 0 = Vanilla behavior (AI does not send expeditionary forces to human players, default)
; 1 = Modified behavior (expeditionary forces to players are allowed unless blacklisted with dont_want_exp_forces)
AllowExpForcesToPlayers = 0

[Map]
; Enable Custom Straits System:
; 0 = Vanilla hardcoded straits (default)
; 1 = Custom straits loaded from db\straits.csv (or map\straits.csv)
EnableCustomStraits = 0

[AI]
; Enable Allied Territory Garrison AI:
; 0 = Vanilla behavior (AI only garrisons owned/controlled provinces and repatriates from allied soil)
; 1 = Enabled (AI can station and garrison divisions in allied territory based on priorities and area_multiplier, default)
EnableAlliedGarrison = 1

[Engine]
; Binary Version Identifier (Global flag GAME_VERSION):
; Controls the numeric value assigned to the GAME_VERSION global flag on scenario/savegame load.
; Default = 1
GameVersion = 1
"@
        [System.IO.File]::WriteAllText($dstIni, $iniDefault, [System.Text.Encoding]::GetEncoding("ISO-8859-1"))
    }

    # Ensure [AI] section exists in destination db\mod_settings.ini
    if (Test-Path $dstIni) {
        $curIniText = [System.IO.File]::ReadAllText($dstIni, [System.Text.Encoding]::GetEncoding("ISO-8859-1"))
        if ($curIniText -notmatch "\[AI\]") {
            $aiAppend = "`r`n`r`n[AI]`r`n; Enable Allied Territory Garrison AI:`r`n; 0 = Vanilla behavior (AI only garrisons owned/controlled provinces and repatriates from foreign soil)`r`n; 1 = Allow garrisons in ally territory only`r`n; 2 = Allow garrisons in ally and military access territory (default)`r`nEnableAlliedGarrison = 2`r`n"
            [System.IO.File]::AppendAllText($dstIni, $aiAppend, [System.Text.Encoding]::GetEncoding("ISO-8859-1"))
        }
        if ($curIniText -notmatch "\[Engine\]") {
            $engineAppend = "`r`n`r`n[Engine]`r`n; Binary Version Identifier (Global flag GAME_VERSION):`r`n; Controls the numeric value assigned to the GAME_VERSION global flag on scenario/savegame load.`r`n; Default = 1`r`nGameVersion = 1`r`n"
            [System.IO.File]::AppendAllText($dstIni, $engineAppend, [System.Text.Encoding]::GetEncoding("ISO-8859-1"))
        }
    }

    # Ensure default db\straits.csv exists in destination directory
    $dstStraits = Join-Path $dstDb "straits.csv"
    if (-not (Test-Path $dstStraits)) {
        $straitsDefault = @"
# Custom Straits Definition File
# SeaProv;LandProv1;LandProv2;LandProv3;LandProv4;Type;Name
# Type: 2 = Normal strait (all land controllers must be at peace with passing country)
#       3 = Allied-only strait (all land controllers must be allied to or grant access to passing country)
# Up to 4 land provinces can be specified. Use 0 for unused slots.
2430;348;0;0;0;2;Strait of Gibraltar
2453;900;0;0;0;2;Suez Canal
290;294;0;0;0;2;The Sound (Copenhagen)
2575;889;0;0;0;2;Panama Canal
397;409;0;0;0;3;The Bosphorus
"@
        [System.IO.File]::WriteAllText($dstStraits, $straitsDefault, [System.Text.Encoding]::GetEncoding("ISO-8859-1"))
    }

    # Also migrate any legacy mod_settings.ini in Mods\ folders
    $modsDir = Join-Path $dstDir "Mods"
    if (Test-Path $modsDir) {
        Get-ChildItem -Path $modsDir -Directory | ForEach-Object {
            $modLegacyIni = Join-Path $_.FullName "mod_settings.ini"
            $modDbDir = Join-Path $_.FullName "db"
            $modDbIni = Join-Path $modDbDir "mod_settings.ini"
            if (Test-Path $modLegacyIni) {
                if (-not (Test-Path $modDbDir)) {
                    New-Item -ItemType Directory -Path $modDbDir -Force | Out-Null
                }
                if (-not (Test-Path $modDbIni)) {
                    Move-Item -Path $modLegacyIni -Destination $modDbIni -Force
                } else {
                    Remove-Item -Path $modLegacyIni -Force
                }
            }
        }
    }

    # Verify dstPath
    $dstState = Check-FileState $dstPath
    $failedSigs = @()
    if (-not $dstState.Sig1Patch)   { $failedSigs += "Patch 1 (Expeditionary Forces)" }
    if (-not $dstState.Sig2Patch)   { $failedSigs += "Patch 2 (Garrison AI Dispatch)" }
    if (-not $dstState.Sig3Patch)   { $failedSigs += "Patch 3 (dont_want_exp_forces Cave)" }
    if (-not $dstState.Sig4Patch)   { $failedSigs += "Patch 4 (Puppet Trade & Veto)" }
    if (-not $dstState.Sig5Patch)   { $failedSigs += "Patch 5 (Checksum Sync)" }
    if (-not $dstState.Sig6Patch)   { $failedSigs += "Patch 6 (Straits System)" }
    if (-not $dstState.SigLaaPatch) { $failedSigs += "Patch 7 (Large Address Aware)" }
    if (-not $dstState.Sig8Patch)   { $failedSigs += "Patch 8 (Event Deallocation Cave)" }
    if (-not $dstState.Sig9Patch)   { $failedSigs += "Patch 9 (Map Guard)" }
    if (-not $dstState.Sig10Patch)  { $failedSigs += "Patch 10 (Silent Events)" }
    if (-not $dstState.Sig11Patch)  { $failedSigs += "Patch 11 (Allied Garrison AI)" }
    if (-not $dstState.Sig12Patch)  { $failedSigs += "Patch 12 (GAME_VERSION Flag)" }
    if ($failedSigs.Count -gt 0) {
        throw ("Verification failed: Target file signatures were not properly updated. Failed: " + ($failedSigs -join ', '))
    }
    return $dstState
}

function Revert-File([string]$origPath, [string]$dstPath) {
    if (-not (Test-Path $origPath)) {
        throw "Original backup not found: $origPath"
    }
    $origState = Check-FileState $origPath
    if (-not $origState.Sig1Orig -or -not $origState.Sig2Orig -or -not $origState.Sig3Orig -or -not $origState.Sig11Orig -or -not $origState.Sig12Orig) {
        throw "Backup file '$origPath' is not a valid pristine Darkest Hour executable."
    }
    try {
        Copy-Item -Path $origPath -Destination $dstPath -Force
    } catch [System.IO.IOException] {
        throw "Target file '$dstPath' is locked or currently in use. Please close the game and try again."
    }
}

# --- Main Flow ---
Show-Header

# Check if a target file was dragged and dropped or passed as argument
if ($TargetFile -and (Test-Path $TargetFile)) {
    $resolvedTarget = [System.IO.Path]::GetFullPath($TargetFile)
    Write-Host "[+] Target file specified: $resolvedTarget" -ForegroundColor Cyan
    $dir = [System.IO.Path]::GetDirectoryName($resolvedTarget)
    $modifiedFile = Join-Path $dir "Darkest Hour_modified.exe"
    try {
        $res = Apply-PatchToFile $resolvedTarget $modifiedFile
        Write-Host "[SUCCESS] Created patched file: $modifiedFile" -ForegroundColor Green
        Write-Host "          SHA256: $($res.Hash)" -ForegroundColor Green
    } catch {
        Write-Host "[ERROR] $($_.Exception.Message)" -ForegroundColor Red
    }
    if (-not $Auto) {
        Write-Host ""
        Read-Host "Press Enter to exit..."
    }
    exit 0
}

# Locate Game Directory
$gameDir = Find-GameDirectory
if (-not $gameDir) {
    Write-Host "[ERROR] Could not locate Darkest Hour installation directory." -ForegroundColor Red
    Write-Host "Please place this batch file in the same directory as 'Darkest Hour.exe'." -ForegroundColor Yellow
    if (-not $Auto) { Read-Host "Press Enter to exit..." }
    exit 1
}

$mainExe = Join-Path $gameDir "Darkest Hour.exe"
$origExe = Join-Path $gameDir "Darkest Hour_original.exe"
$modExe  = Join-Path $gameDir "Darkest Hour_modified.exe"

Write-Host " Game Directory: $gameDir" -ForegroundColor White
Write-Host ""

$mainState = Check-FileState $mainExe
$origState = Check-FileState $origExe
$modState  = Check-FileState $modExe

Write-Host " Detected Executables:" -ForegroundColor Yellow
Write-Host ("   1. Darkest Hour_original.exe : {0} {1}" -f $origState.State, $(if ($origState.Exists) { "($($origState.Hash.Substring(0,16))...)" } else { "" }))
Write-Host ("   2. Darkest Hour_modified.exe : {0} {1}" -f $modState.State,  $(if ($modState.Exists)  { "($($modState.Hash.Substring(0,16))...)" } else { "" }))
Write-Host ("   3. Darkest Hour.exe (Active) : {0} {1}" -f $mainState.State, $(if ($mainState.Exists) { "($($mainState.Hash.Substring(0,16))...)" } else { "" }))
Write-Host "-------------------------------------------------------------------------------" -ForegroundColor Gray

# Determine action
$action = "1"
if ($Apply -or $Auto) {
    $action = "1"
} elseif ($Revert) {
    $action = "3"
} elseif ($Verify) {
    $action = "4"
} elseif ($Help) {
    Write-Host "Usage: patch_darkest_hour.bat [-Apply] [-Revert] [-Verify] [-Auto] [TargetFile]"
    exit 0
} else {
    Write-Host "`nChoose an option:" -ForegroundColor Yellow
    Write-Host "  [1] Apply All Patches (Active: Darkest Hour.exe + Darkest Hour_modified.exe)"
    Write-Host "  [2] Create / Update 'Darkest Hour_modified.exe' only (leave active exe unchanged)"
    Write-Host "  [3] Revert 'Darkest Hour.exe' to original vanilla from backup"
    Write-Host "  [4] Verify integrity and show SHA256 hashes"
    Write-Host "  [5] Exit"
    Write-Host ""
    $action = Read-Host "Enter selection [1-5] (default: 1)"
    if ([string]::IsNullOrWhiteSpace($action)) { $action = "1" }
}

try {
    switch ($action) {
        "1" {
            Write-Host "`n[*] Applying all patches to Darkest Hour..." -ForegroundColor Cyan

            # Ensure we have Darkest Hour_original.exe backed up
            if (-not $origState.Exists -or ($origState.State -ne "Original")) {
                if ($mainState.Exists -and ($mainState.State -eq "Original")) {
                    Write-Host "[+] Backing up pristine 'Darkest Hour.exe' to 'Darkest Hour_original.exe'..." -ForegroundColor Green
                    Copy-Item -Path $mainExe -Destination $origExe -Force
                    $origState = Check-FileState $origExe
                } elseif (-not $origState.Exists) {
                    Write-Host "[WARNING] No pristine 'Darkest Hour_original.exe' backup found." -ForegroundColor Yellow
                    Write-Host "          Proceeding to patch using active executable as baseline." -ForegroundColor Yellow
                }
            }

            $sourceForPatch = if ($origState.Exists -and ($origState.State -eq "Original")) { $origExe } else { $mainExe }
            
            # Patch Darkest Hour_modified.exe
            Write-Host "[+] Updating 'Darkest Hour_modified.exe'..." -ForegroundColor Cyan
            $modRes = Apply-PatchToFile $sourceForPatch $modExe
            Write-Host "    -> SHA256: $($modRes.Hash)" -ForegroundColor Green

            # Patch active Darkest Hour.exe
            Write-Host "[+] Updating active 'Darkest Hour.exe'..." -ForegroundColor Cyan
            $mainRes = Apply-PatchToFile $sourceForPatch $mainExe
            Write-Host "    -> SHA256: $($mainRes.Hash)" -ForegroundColor Green

            Write-Host "`n[SUCCESS] Darkest Hour has been successfully patched with all fixes!" -ForegroundColor Green
        }

        "2" {
            Write-Host "`n[*] Updating 'Darkest Hour_modified.exe' only..." -ForegroundColor Cyan
            $sourceForPatch = if ($origState.Exists -and ($origState.State -eq "Original")) { $origExe } else { $mainExe }
            $modRes = Apply-PatchToFile $sourceForPatch $modExe
            Write-Host "[SUCCESS] Created/Updated: $modExe" -ForegroundColor Green
            Write-Host "          SHA256: $($modRes.Hash)" -ForegroundColor Green
        }

        "3" {
            Write-Host "`n[*] Reverting active executable to original vanilla..." -ForegroundColor Cyan
            if (-not $origState.Exists) {
                throw "Cannot revert: 'Darkest Hour_original.exe' was not found."
            }
            Revert-File $origExe $mainExe
            $res = Check-FileState $mainExe
            Write-Host "[SUCCESS] Reverted active 'Darkest Hour.exe' to original vanilla." -ForegroundColor Green
            Write-Host "          SHA256: $($res.Hash)" -ForegroundColor Green
        }

        "4" {
            Write-Host "`n[*] File Integrity Verification:" -ForegroundColor Cyan
            Write-Host ("Darkest Hour_original.exe : {0} | SHA256={1}" -f $origState.State, $origState.Hash)
            Write-Host ("Darkest Hour_modified.exe : {0} | SHA256={1}" -f $modState.State,  $modState.Hash)
            Write-Host ("Darkest Hour.exe (Active) : {0} | SHA256={1}" -f $mainState.State, $mainState.Hash)
        }

        "5" {
            Write-Host "`nExiting without changes."
        }

        default {
            Write-Host "`nInvalid selection." -ForegroundColor Red
        }
    }
} catch {
    Write-Host "`n[ERROR] $($_.Exception.Message)" -ForegroundColor Red
    if (-not $Auto) {
        Write-Host ""
        Read-Host "Press Enter to exit..."
    }
    exit 1
}

if (-not $Auto -and -not $Apply -and -not $Revert -and -not $Verify) {
    Write-Host ""
    Read-Host "Press Enter to exit..."
}
exit 0

